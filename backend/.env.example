# Must match docker-compose.yml unless you use your own PostgreSQL credentials.
DATABASE_URL=postgresql+psycopg://rbi_user:rbi_password@localhost:5432/rbi_capstone

# Use "ollama" for a local Ollama server, or "openrouter" with an API key.
LLM_PROVIDER=openrouter

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-8b

RETRIEVAL_TOP_K=3
