# Must match docker-compose.yml unless you use your own PostgreSQL credentials.
DATABASE_URL=postgresql+psycopg://rbi_user:rbi_password@localhost:5432/rbi_capstone

# Comma-separated browser origins; set this to the exact deployed frontend origin in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use "ollama" for a local Ollama server, or "openrouter" with an API key.
LLM_PROVIDER=openrouter

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-8b

RETRIEVAL_TOP_K=3

# Optional email delivery for the daily regulatory digest.
# Preview mode never sends. Use `python -m scripts.send_daily_digest --send`
# only after testing the preview and configuring a real mailbox/provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
DAILY_DIGEST_TO=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
